#!/bin/bash
# Colorful Terminals helper: edits projects.conf, opens projects, and adds or
# removes the marked blocks that wire the plugin into your shells, Hyprland,
# and the Omarchy menu. The settings panel calls it with argv, never a shell
# string. Run with no arguments for help.

set -euo pipefail
shopt -s extglob

PLUGIN_ID="andreiyurik.colorful-terminals"
helper_path=$(readlink -f -- "${BASH_SOURCE[0]}")
plugin_dir=${helper_path%/bin/*}

# shellcheck source=lib/config.bash
source "$plugin_dir/lib/config.bash"

config_dir=${_ct_file%/*}
backup_dir="$config_dir/backup"
max_keys=9
paint_keys=8   # Super+Ctrl+Alt+Shift+1…8 color the focused terminal

# Seven hues spaced around the OKLCH color wheel at one lightness (L 0.34) and
# one chroma (0.09), placed so the two closest colors are as far apart as the
# wheel allows, plus black. Every stock Omarchy theme's text reads on each
# (contrast 5.1 or better), and each stands off every dark theme background.
# The order is by use, not by hue: red for production is a terminal convention.
# tests/palette.test.js checks all of this against the 22 stock themes.
# Ordered by key: Super+Ctrl+Alt+Shift+1 is Blue. Same names in hypr/keys.lua.
palette_names=(Blue Green Red Purple Orange Teal Magenta Black)
palette_colors=("#003b63" "#1a4311" "#5e2024" "#3c2c61" "#582a00" "#00454a" "#572142" "#000000")
# The same for light themes (L 0.87, chroma 0.065), with a neutral gray in
# black's place: white would vanish into most light theme backgrounds.
light_names=(Blue Green Red Purple Peach Aqua Pink Gray)
light_colors=("#aedbfb" "#bedfb7" "#fcc4c3" "#d3cefd" "#f3cca8" "#a1e2e5" "#f3c4e2" "#d9d9d9")

usage() {
  cat <<EOF
Usage: colorful-terminals <command>

Projects (stored in ${_ct_file/#"$HOME"/\~}):
  list                     Show projects, their keys and colors
  add <folder> [#rrggbb]   Add a project; without a color it gets a free one
      [--at <n>]           ...at position n instead of the end
  remove <n>               Remove project n
  move <n> up|down         Move project n, which changes its Super+Ctrl+Alt key
  color <n> <#rrggbb>      Change the color of project n
  open <n>                 Open project n in a terminal, or focus its window

Any terminal (Super+Ctrl+Alt+Shift+1…8 give the focused terminal a color, 0 takes it away):
  paint <1-8|0>            What those keys run
  paint-color <n> <#rrggbb>|default
                           Change the color on Super+Ctrl+Alt+Shift+n

Integration (shell hooks for bash, zsh and fish, Hyprland keys, Omarchy menu entry):
  integration status       Show what is installed
  integration preview      Show exactly what install would add
  integration install [--yes]
  integration uninstall [--yes]
EOF
}

die() {
  printf 'colorful-terminals: %s\n' "$*" >&2
  exit 1
}

display_path() {
  local path=$1
  if [[ $path == "$HOME" ]]; then
    printf '~'
  elif [[ $path == "$HOME"/* ]]; then
    printf '~/%s' "${path#"$HOME"/}"
  else
    printf '%s' "$path"
  fi
}

lower() { printf '%s' "${1,,}"; }

valid_color() { [[ $1 =~ ^#[0-9A-Fa-f]{6}$ ]]; }

# ---------------------------------------------------------------- config file

lines=()           # every line of projects.conf
project_lines=()   # index into lines[] of each project, in order

read_config() {
  lines=() project_lines=()
  [[ -f $_ct_file ]] || return 0
  local line i=0
  while IFS= read -r line || [[ -n $line ]]; do
    lines+=("$line")
    _ct_parse_line "$line"
    [[ $_ct_kind == project ]] && project_lines+=("$i")
    i=$((i + 1))
  done < "$_ct_file"
}

default_header() {
  lines=(
    "# Colorful Terminals: one project per line, the folder and then its color."
    "# The 1st project opens with Super+Ctrl+Alt+1, the 2nd with Super+Ctrl+Alt+2, up to 9."
    "# Colors are #rrggbb. Edit here or in the panel (Super+Ctrl+Alt+0); both stay in sync."
    ""
  )
}

format_project() {
  local path_text=$1 color=$2 comment=${3-} width=24
  ((${#path_text} + 2 > width)) && width=$((${#path_text} + 2))
  printf '%-*s%s%s' "$width" "$path_text" "$color" "$comment"
}

# Writes lines[] back atomically: temp file in the same folder, then rename.
write_config() {
  mkdir -p "$config_dir"
  local tmp
  tmp=$(mktemp "$config_dir/.projects.conf.XXXXXX")
  if ((${#lines[@]})); then printf '%s\n' "${lines[@]}" > "$tmp"; fi
  if [[ -f $_ct_file ]]; then chmod --reference="$_ct_file" "$tmp"; else chmod 644 "$tmp"; fi
  mv -f "$tmp" "$_ct_file"
}

lock_config() {
  mkdir -p "$config_dir"
  exec 9> "$config_dir/.lock"
  flock -w 5 9 || die "another change is still being saved"
}

project_count() { printf '%s' "${#project_lines[@]}"; }

require_index() {
  local n=$1
  [[ $n =~ ^[1-9][0-9]*$ ]] || die "project number must be 1 or more, got '$n'"
  ((n <= ${#project_lines[@]})) || die "there is no project $n (you have $(project_count))"
}

# Parses lines[] at a project index into _ct_* fields.
parse_project() { _ct_parse_line "${lines[${project_lines[$(($1 - 1))]}]}"; }

normalize_folder() {
  local path=$1
  case $path in
    "~") path=$HOME ;;
    "~/"*) path=$HOME/${path:2} ;;
    /*) ;;
    *) die "use a full folder path like ~/code/shop or /srv/app, got '$path'" ;;
  esac
  while [[ $path == */ && $path != / ]]; do path=${path%/}; done
  [[ $path != *[$'\n\t\r']* ]] || die "folder names with tabs or line breaks are not supported"
  [[ ! $path =~ [[:space:]]#([[:space:]]|$) && $path != *[[:space:]] ]] ||
    die "folder names with ' #' or a trailing space are not supported"
  [[ -d $path ]] || die "no such folder: $path"
  printf '%s' "$path"
}

free_color() {
  local used=" ${*,,} " i
  for i in "${!palette_colors[@]}"; do
    [[ $used == *" ${palette_colors[i]} "* ]] || { printf '%s' "${palette_colors[i]}"; return; }
  done
  printf '%s' "${palette_colors[$(($# % ${#palette_colors[@]}))]}"
}

cmd_list() {
  _ct_load
  local i key
  if ((${#_ct_paths[@]} == 0)); then
    echo "No projects yet. Add one with: colorful-terminals add <folder>"
  fi
  for i in "${!_ct_paths[@]}"; do
    key="Super+Ctrl+Alt+$((i + 1))"
    ((i < max_keys)) || key="(no key)"
    printf '%-2s %-17s %s  %s\n' "$((i + 1))" "$key" "${_ct_colors[i]}" "$(display_path "${_ct_paths[i]}")"
  done
  echo
  echo "Any terminal:"
  read_config
  for ((i = 1; i <= paint_keys; i++)); do
    printf '   %-23s %s  %s\n' "Super+Ctrl+Alt+Shift+$i" "$(paint_color "$i")" "$(paint_name "$i")"
  done
  printf '   %-23s back to the project or theme color\n' "Super+Ctrl+Alt+Shift+0"
}

cmd_add() {
  local folder="" color="" at="" arg
  while (($#)); do
    arg=$1
    shift
    case $arg in
      --at) at=${1-}; shift || true ;;
      \#*) color=$arg ;;
      *) [[ -z $folder ]] || die "only one folder at a time"; folder=$arg ;;
    esac
  done
  [[ -n $folder ]] || die "which folder? Example: colorful-terminals add ~/code/shop"
  folder=$(normalize_folder "$folder")
  [[ -z $color ]] || valid_color "$color" || die "colors look like #243453, got '$color'"

  lock_config
  read_config
  local i used=()
  for i in "${!project_lines[@]}"; do
    parse_project $((i + 1))
    [[ $_ct_path != "$folder" ]] || die "$(display_path "$folder") is already project $((i + 1))"
    used+=("$_ct_color")
  done
  [[ -n $color ]] || color=$(free_color "${used[@]}")
  color=$(lower "$color")

  ((${#lines[@]})) || default_header
  local entry pos count=${#project_lines[@]} n
  entry=$(format_project "$(display_path "$folder")" "$color")
  if [[ -n $at ]]; then
    [[ $at =~ ^[1-9][0-9]*$ ]] || die "--at needs a project number"
  fi
  if [[ -n $at ]] && ((at <= count)); then
    pos=${project_lines[$((at - 1))]}
    n=$at
  elif ((count)); then
    pos=$((${project_lines[$((count - 1))]} + 1))
    n=$((count + 1))
  else
    pos=${#lines[@]}
    n=1
  fi
  lines=("${lines[@]:0:pos}" "$entry" "${lines[@]:pos}")
  write_config
  refresh_keys
  if ((n <= max_keys)); then
    echo "Added $(display_path "$folder") as project $n (Super+Ctrl+Alt+$n)"
  else
    echo "Added $(display_path "$folder") as project $n (colors only; keys go up to $max_keys)"
  fi
}

cmd_remove() {
  (($# == 1)) || die "usage: colorful-terminals remove <n>"
  lock_config
  read_config
  require_index "$1"
  local pos=${project_lines[$(($1 - 1))]}
  parse_project "$1"
  lines=("${lines[@]:0:pos}" "${lines[@]:pos+1}")
  write_config
  refresh_keys
  echo "Removed $_ct_path_text"
}

cmd_move() {
  (($# == 2)) || die "usage: colorful-terminals move <n> up|down"
  local n=$1 other
  lock_config
  read_config
  require_index "$n"
  case $2 in
    up) other=$((n - 1)) ;;
    down) other=$((n + 1)) ;;
    *) die "move <n> up or move <n> down" ;;
  esac
  if ((other < 1 || other > ${#project_lines[@]})); then
    echo "Project $n is already at the $([[ $2 == up ]] && echo top || echo bottom)"
    return
  fi
  local a=${project_lines[$((n - 1))]} b=${project_lines[$((other - 1))]} tmp
  tmp=${lines[a]}
  lines[a]=${lines[b]}
  lines[b]=$tmp
  write_config
  refresh_keys
  parse_project "$other"
  echo "$_ct_path_text is now project $other"
}

cmd_color() {
  (($# == 2)) || die "usage: colorful-terminals color <n> <#rrggbb>"
  valid_color "$2" || die "colors look like #243453, got '$2'"
  lock_config
  read_config
  require_index "$1"
  parse_project "$1"
  lines[${project_lines[$(($1 - 1))]}]=$(format_project "$_ct_path_text" "$(lower "$2")" "$_ct_comment")
  write_config
  echo "$_ct_path_text is now $(lower "$2")"
}

# Keys read projects.conf when pressed; only their names in the keybindings
# list go stale when projects or colors change. This refreshes them by running
# hypr/keys.lua again inside Hyprland with { rebind = true }: each of our keys
# is unbound and bound again, and nothing else is touched. Never `hyprctl
# reload`: that re-applies the whole config, resets monitors and undoes what
# other plugins set at runtime. Skipped when another binding shares one of our
# keys, since unbind would take that one too (the panel shows the clash), and
# when Hyprland or the keys block is not there. A failure changes nothing:
# the names catch up at the next login.
refresh_keys() {
  [[ -n ${HYPRLAND_INSTANCE_SIGNATURE-} ]] && command -v hyprctl > /dev/null && has_block hyprland || return 0
  [[ $(find_conflicts) == "[]" ]] || return 0
  timeout 3 hyprctl eval "$(rebind_lua)" > /dev/null 2>&1 || true
}

rebind_lua() {
  printf 'local dir = %s; local f = io.open(dir .. "/hypr/keys.lua"); if f then f:close(); dofile(dir .. "/hypr/keys.lua")(dir, { rebind = true }) end' \
    "$(lua_path "$plugin_dir")"
}

notify() {
  local body=${2//[<>&]/}
  if command -v notify-send > /dev/null; then
    notify-send -a "Colorful Terminals" -- "$1" "${body:0:300}" || true
  else
    printf '%s: %s\n' "$1" "$body" >&2
  fi
}

# App id for a project window. Two projects with the same folder name get the
# project number appended, so each key finds its own window.
app_id_for() {
  local n=$1 i name mine="" count=0
  for i in "${!_ct_paths[@]}"; do
    name=${_ct_paths[i]##*/}
    name=${name//[^A-Za-z0-9_]/_}
    [[ -n $name ]] || name=root
    ((i + 1 == n)) && mine=$name
  done
  for i in "${!_ct_paths[@]}"; do
    name=${_ct_paths[i]##*/}
    name=${name//[^A-Za-z0-9_]/_}
    [[ -n $name ]] || name=root
    [[ $name == "$mine" ]] && count=$((count + 1))
  done
  if ((count > 1)); then
    printf 'org.omarchy.project_%s_%s' "$mine" "$n"
  else
    printf 'org.omarchy.project_%s' "$mine"
  fi
}

cmd_open() {
  if (($# != 1)) || [[ ! $1 =~ ^[0-9]+$ ]]; then die "usage: colorful-terminals open <n>"; fi
  local n=$1
  _ct_load
  if ((n < 1 || n > ${#_ct_paths[@]})); then
    # A key without a project opens the panel, so the fix is one step away.
    exec omarchy-shell shell summon "$PLUGIN_ID" '{}'
  fi
  local dir=${_ct_paths[$((n - 1))]} app_id
  if [[ ! -d $dir ]]; then
    notify "Project folder not found" "$(display_path "$dir") no longer exists. Press Super+Ctrl+Alt+0 to fix the list."
    exit 1
  fi
  app_id=$(app_id_for "$n")
  exec omarchy-launch-or-focus "$app_id" \
    "uwsm-app -- xdg-terminal-exec --app-id=$app_id --dir=$(printf '%q' "$dir")"
}

# --------------------------------------------------------------- any terminal

# Omarchy's current theme is light when its background is: the same test as
# the panel's (Model.isLightTheme).
theme_is_light() {
  local file=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme/colors.toml hex
  [[ -r $file ]] || return 1
  hex=$(grep -m1 -E '^[[:space:]]*background[[:space:]]*=' "$file" | grep -oE '#[0-9a-fA-F]{6}') || return 1
  awk -v r=$((16#${hex:1:2})) -v g=$((16#${hex:3:2})) -v b=$((16#${hex:5:2})) '
    function ch(x) { x = x / 255; return x <= 0.03928 ? x / 12.92 : ((x + 0.055) / 1.055) ^ 2.4 }
    BEGIN { exit !(0.2126 * ch(r) + 0.7152 * ch(g) + 0.0722 * ch(b) > 0.35) }'
}

# The paint-<n> setting in lines[] (read_config first), or "".
paint_setting() {
  local line
  paint_setting_at=-1
  for line in "${!lines[@]}"; do
    _ct_parse_line "${lines[line]}"
    if [[ $_ct_kind == setting && $_ct_key == "paint-$1" ]]; then paint_setting_at=$line; fi
  done
  ((paint_setting_at >= 0)) || return 0
  _ct_parse_line "${lines[paint_setting_at]}"
  printf '%s' "${_ct_value,,}"
}

# The color on Super+Ctrl+Alt+Shift+<n>: the setting, or else the nth palette
# color for the current theme.
paint_color() {
  local color
  color=$(paint_setting "$1")
  if valid_color "$color"; then
    printf '%s' "$color"
  elif theme_is_light; then
    printf '%s' "${light_colors[$1 - 1]}"
  else
    printf '%s' "${palette_colors[$1 - 1]}"
  fi
}

paint_name() {
  local color i
  color=$(paint_color "$1")
  for i in "${!palette_colors[@]}"; do
    [[ ${palette_colors[i]} != "$color" ]] || { printf '%s' "${palette_names[i]}"; return; }
    [[ ${light_colors[i]} != "$color" ]] || { printf '%s' "${light_names[i]}"; return; }
  done
  printf 'your color'
}

cmd_paint_color() {
  (($# == 2)) || die "usage: colorful-terminals paint-color <1-$paint_keys> <#rrggbb>|default"
  local n=$1 color=${2,,} line
  if [[ ! $n =~ ^[1-9]$ ]] || ((n > paint_keys)); then die "the color keys go from 1 to $paint_keys, got '$n'"; fi
  [[ $color == default ]] || valid_color "$color" || die "colors look like #243453, got '$2'"
  lock_config
  read_config
  paint_setting "$n" > /dev/null
  line=$(printf 'paint-%s = %s' "$n" "$color")
  if [[ $color == default ]]; then
    ((paint_setting_at < 0)) || lines=("${lines[@]:0:paint_setting_at}" "${lines[@]:paint_setting_at+1}")
    drop_paint_header
  elif ((paint_setting_at >= 0)); then
    lines[paint_setting_at]=$line
  else
    ((${#lines[@]})) || default_header
    add_paint_setting "$n" "$line"
  fi
  write_config
  refresh_keys
  if [[ $color == default ]]; then
    echo "Super+Ctrl+Alt+Shift+$n is back to $(paint_color "$n")"
  else
    echo "Super+Ctrl+Alt+Shift+$n is now $color"
  fi
}

paint_header="# Super+Ctrl+Alt+Shift+1…$paint_keys color the terminal you are in; +0 takes the color away."

# Puts a paint-<n> line in order among the others, under a comment that says
# what they are.
add_paint_setting() {
  local n=$1 line=$2 i pos=-1 header=-1
  for i in "${!lines[@]}"; do
    [[ ${lines[i]} == "$paint_header" ]] && header=$i
    _ct_parse_line "${lines[i]}"
    if [[ $_ct_kind == setting && $_ct_key =~ ^paint-([0-9]+)$ ]]; then
      if ((BASH_REMATCH[1] < n)); then pos=$((i + 1)); elif ((pos < 0)); then pos=$i; fi
    fi
  done
  if ((pos < 0 && header >= 0)); then pos=$((header + 1)); fi
  if ((pos < 0)); then
    # First one: at the end, after a blank line and the comment.
    [[ ${#lines[@]} -eq 0 || -z ${lines[-1]} ]] || lines+=("")
    lines+=("$paint_header" "$line")
    return
  fi
  lines=("${lines[@]:0:pos}" "$line" "${lines[@]:pos}")
}

# Takes the comment away with the last paint-<n> line.
drop_paint_header() {
  local i header=-1
  for i in "${!lines[@]}"; do
    _ct_parse_line "${lines[i]}"
    [[ $_ct_kind == setting && $_ct_key == paint-* ]] && return
    [[ ${lines[i]} == "$paint_header" ]] && header=$i
  done
  ((header >= 0)) || return 0
  lines=("${lines[@]:0:header}" "${lines[@]:header+1}")
  # And the blank line that was put before it.
  if ((header > 0 && header == ${#lines[@]})) && [[ -z ${lines[-1]} ]]; then unset 'lines[-1]'; fi
}

# What Super+Ctrl+Alt+Shift+<n> runs (0 takes the color away). It colors the
# focused terminal only where it can tell exactly which one that is, and never
# guesses:
#  - A shell at its prompt does it itself, so it is always that terminal, even
#    when one terminal program draws every window: the color goes into
#    $XDG_RUNTIME_DIR/colorful-terminals/paint, Hyprland presses
#    Ctrl+Alt+Shift+F12 in the focused window, and the shell hook's key
#    binding takes the color and empties the file.
#  - While a program runs (an editor, ssh, Claude Code), the shell cannot
#    answer and the key would go to the program, so the helper finds the
#    window's terminal itself (see find_target), colors it, and leaves the
#    color in tty/<name> for the shell's next prompt to keep.
#  - When neither works, a notification says so and nothing changes.
# Then, for a color, it offers to remember it for the terminal's folder (see
# cmd_offer).
cmd_paint() {
  if (($# != 1)) || [[ ! $1 =~ ^[0-9]$ ]] || (($1 > paint_keys)); then die "usage: colorful-terminals paint <1-$paint_keys|0>"; fi
  local n=$1 color=reset dir request tmp i window answer=() folder="" inbox=""
  [[ -n ${XDG_RUNTIME_DIR-} && -d $XDG_RUNTIME_DIR ]] || die "XDG_RUNTIME_DIR is not set"
  if [[ -z ${HYPRLAND_INSTANCE_SIGNATURE-} ]] || ! command -v hyprctl > /dev/null; then die "this needs Hyprland"; fi
  window=$(focused_window)
  if ! jq -e '(.tags // []) | map(sub("\\*$"; "")) | index("terminal") != null' > /dev/null 2>&1 <<< "$window"; then
    notify "No terminal in focus" "Click a terminal, then press Super+Ctrl+Alt+Shift+$n again."
    exit 1
  fi
  read_config
  ((n == 0)) || color=$(paint_color "$n")

  dir=$XDG_RUNTIME_DIR/colorful-terminals
  [[ -d $dir ]] || mkdir -m 700 "$dir"
  find_target "$(jq -r '.pid // 0' <<< "$window" 2> /dev/null || echo 0)"
  if [[ -z $target_tty || $target_front == shell ]]; then
    request=$dir/paint
    tmp=$(mktemp "$dir/.paint.XXXXXX")
    printf '%s\n' "$color" > "$tmp"
    mv -f "$tmp" "$request"
    timeout 3 hyprctl eval "$send_key_lua" > /dev/null 2>&1 || true
    # The shell answers by replacing the color with its file name and folder
    # (an older hook empties the file instead).
    for ((i = 0; i < 40; i++)); do
      [[ $(head -n 1 "$request" 2> /dev/null) == "$color" ]] || break
      sleep 0.025
    done
    if [[ $(head -n 1 "$request" 2> /dev/null) != "$color" ]]; then
      sleep 0.05
      mapfile -t -n 2 answer < "$request" 2> /dev/null || true
      rm -f -- "$request"
      inbox=${answer[0]-} folder=${answer[1]-}
      [[ $inbox =~ ^[A-Za-z0-9-]+$ ]] && inbox=$dir/tty/$inbox || inbox=""
      [[ -n $folder ]] || folder=$(target_folder)
      offer "$n" "$color" "$folder" "$inbox"
      return
    fi
    rm -f -- "$request"
    # A shell that did not answer at its prompt: one opened before the hook
    # was added, or busy in a loop of its own.
    if [[ -z $target_tty ]]; then
      notify "The terminal kept its color" "Its window holds several terminals, and the one you are in did not answer: a program is running there, or it was opened before Colorful Terminals was turned on. Press the key again at a shell prompt."
      exit 1
    fi
  fi
  paint_target "$color"
  offer "$n" "$color" "$(target_folder)" "$(inbox_for "$target_tty")"
}

# The folder of the shell found by find_target.
target_folder() {
  if [[ -n $target_shell ]]; then
    readlink "/proc/$target_shell/cwd" 2> /dev/null || true
  fi
}

# tty/<name> for a tty: /dev/pts/3 is tty/pts-3, as the shell hooks name it.
inbox_for() {
  local name=${1#/dev/}
  printf '%s' "$XDG_RUNTIME_DIR/colorful-terminals/tty/${name//\//-}"
}

# Asks, in the background so the key returns at once, whether to remember
# color key <n>'s <color> for <folder>.
offer() {
  local n=$1 color=$2 folder=$3 inbox=$4
  ((n)) && [[ -n $folder ]] && command -v notify-send > /dev/null || return 0
  setsid -f "$helper_path" offer "$color" "$folder" "$inbox" < /dev/null > /dev/null 2>&1 || true
}

# After a color key: "Keep this color for shop?" with a Remember button,
# for the git repository the terminal is in (or its folder). Remember makes
# the folder a project in that color, or gives an existing project that
# color, and hands the terminal back to its project color through <inbox>.
# Not for ~ or /, and not when the project already has that color.
cmd_offer() {
  (($# == 3)) || die "usage: colorful-terminals offer <#rrggbb> <folder> <terminal file>"
  local color=${1,,} folder=$2 inbox=$3 root name shown i n=0 old="" title body button action out key
  valid_color "$color" && [[ -d $folder ]] || return 0
  root=$(timeout 2 git -C "$folder" rev-parse --show-toplevel 2> /dev/null) && [[ -d $root ]] && folder=$root
  [[ $folder != "$HOME" && $folder != / ]] || return 0
  read_config
  for i in "${!project_lines[@]}"; do
    parse_project $((i + 1))
    if [[ $_ct_path == "$folder" ]]; then n=$((i + 1)) old=${_ct_color,,}; fi
  done
  [[ $old != "$color" ]] || return 0
  # Inside a project of that color already: nothing to remember.
  _ct_load
  _ct_match_dir "$folder"
  ((n)) || [[ ${_ct_match,,} != "$color" ]] || return 0
  shown=$(display_path "$folder")
  name=${folder##*/}
  if ((n)); then
    title="Make $name this color?"
    body="$shown is project $n. Every terminal there will turn this color."
    button="Change color"
  else
    title="Keep this color for $name?"
    key=$((${#project_lines[@]} + 1))
    body="Every terminal in $shown will turn this color"
    if ((key <= max_keys)); then body+=", and Super+Ctrl+Alt+$key will open it."; else body+="."; fi
    button="Remember"
  fi
  action=$(timeout 600 notify-send -a "Colorful Terminals" --expire-time=10000 --action="remember=$button" -- "$title" "$body" 2> /dev/null) || return 0
  [[ $action == remember ]] || return 0
  if ((n)); then
    out=$( (cmd_color "$n" "$color") 2>&1) || { notify "The color was not saved" "$out"; return 1; }
  else
    out=$( (cmd_add "$folder" "$color") 2>&1) || { notify "The color was not saved" "$out"; return 1; }
  fi
  # The terminal follows its project from now on, so leaving the folder
  # brings the theme color back.
  if [[ $inbox == "$XDG_RUNTIME_DIR/colorful-terminals/tty/"* && -d ${inbox%/*} ]]; then
    printf 'reset\n' > "$inbox"
  fi
  if ((n)); then
    notify "$name is this color now" "Every terminal in $shown turns it."
  else
    if ((key <= max_keys)); then
      notify "$name is a project now" "Super+Ctrl+Alt+$key opens it. All projects: Super+Ctrl+Alt+0."
    else
      notify "$name is a project now" "Its color is saved; the keys go up to $max_keys. All projects: Super+Ctrl+Alt+0."
    fi
  fi
}

# Ctrl+Alt+Shift+F12, to the focused surface with explicit mods, the way
# Omarchy's own Super+C sends Ctrl+Insert to terminals (bindings/clipboard.lua):
# the held Super does not leak in, and the key is released after 50 ms.
send_key_lua='hl.dispatch(hl.dsp.send_key_state({ mods = "CTRL ALT SHIFT", key = "F12", state = "down" }))
hl.timer(function() hl.dispatch(hl.dsp.send_key_state({ mods = "CTRL ALT SHIFT", key = "F12", state = "up" })) end, { timeout = 50, type = "oneshot" })'

focused_window() {
  timeout 3 hyprctl activewindow -j 2> /dev/null | head -c 65536 || true
}

# Finds the terminal in the window of process <pid>, and sets:
#   target_tty     its tty, or "" when there is no telling which one it is
#   target_front   "shell" when a shell sits at the front of it (it can answer
#                  the key), else the program running there
#   target_pane    the tmux pane on that tty, and target_tmux the tmux command
#                  for its server ("" outside tmux)
#   target_shell   the shell that owns the tty, for the project color
# A terminal program that runs one process per window (foot, and Alacritty,
# Ghostty and Kitty unless told to share one) has one tty under it, so that is
# the one. Several ttys under one process (shared windows, tabs, splits) are
# told apart only by Kitty, through its remote control socket; otherwise
# target_tty stays empty.
find_target() {
  local pid=$1 child tty ttys=() shells=()
  target_tty="" target_front="" target_pane="" target_tmux=() target_shell=""
  [[ $pid =~ ^[1-9][0-9]*$ && -O /proc/$pid ]] || return 0
  for child in $(children_of "$pid"); do
    # The terminal starts each shell as the leader of a session on its tty.
    if ! proc_stat "$child" || ((stat_session != child)); then continue; fi
    tty=$(proc_tty "$child") || continue
    [[ " ${ttys[*]} " == *" $tty "* ]] || { ttys+=("$tty"); shells+=("$child"); }
  done
  if ((${#ttys[@]} == 1)); then
    target_tty=${ttys[0]} target_shell=${shells[0]}
  elif ((${#ttys[@]} > 1)); then
    kitty_focused "$pid" || return 0
  else
    return 0
  fi
  front_of "$target_shell"
  [[ $target_front == tmux ]] && tmux_pane
  return 0
}

children_of() {
  local f kids
  for f in /proc/"$1"/task/*/children; do
    # The list has no newline at the end, so read "fails" with it read.
    kids=""
    { read -r kids < "$f"; } 2> /dev/null || [[ -n $kids ]] || continue
    printf '%s\n' "$kids"
  done
}

# Sets stat_* from /proc/<pid>/stat. The command name may hold spaces and
# parentheses, so the fields are read after its last ")".
proc_stat() {
  local line fields
  { line=$(< "/proc/$1/stat"); } 2> /dev/null || return 1
  read -ra fields <<< "${line##*) }"
  stat_session=${fields[3]} stat_tpgid=${fields[5]}
}

# Prints the pseudo-terminal of <pid>: its stdin, stdout or stderr, owned by
# you.
proc_tty() {
  local fd tty
  for fd in 0 1 2; do
    tty=$(readlink "/proc/$1/fd/$fd" 2> /dev/null) || continue
    if [[ $tty =~ ^/dev/pts/[0-9]+$ && -O $tty && -w $tty ]]; then
      printf '%s' "$tty"
      return 0
    fi
  done
  return 1
}

# Sets target_front from what holds the front of the tty of shell <pid>.
front_of() {
  local comm=""
  proc_stat "$1" || { target_front=unknown; return 0; }
  { comm=$(< "/proc/$stat_tpgid/comm"); } 2> /dev/null || comm=unknown
  case $comm in
    bash | zsh | fish) target_front=shell ;;
    tmux*) target_front=tmux target_client=$stat_tpgid ;;
    *) target_front=$comm ;;
  esac
}

# The window's tty runs a tmux client: the tmux server tells which pane that
# client shows, and the pane's tty is the target. The client's own -L or -S
# says which server; the first word that is not an option ends them.
tmux_pane() {
  local args=() i line pane tty pid
  command -v tmux > /dev/null || { target_tty=""; return 0; }
  mapfile -d '' args < "/proc/$target_client/cmdline" 2> /dev/null || true
  target_tmux=(tmux)
  for ((i = 1; i < ${#args[@]}; i++)); do
    case ${args[i]} in
      -L | -S) target_tmux+=("${args[i]}" "${args[i + 1]-}"); ((i += 1)) ;;
      -L?* | -S?*) target_tmux+=("${args[i]}") ;;
      -c | -f | -T) ((i += 1)) ;;
      -*) ;;
      *) break ;;
    esac
  done
  line=$(timeout 2 "${target_tmux[@]}" display-message -p -c "$target_tty" '#{pane_id} #{pane_tty} #{pane_pid}' 2> /dev/null) || line=""
  read -r pane tty pid <<< "$line"
  if [[ ! $pane =~ ^%[0-9]+$ || ! $tty =~ ^/dev/pts/[0-9]+$ || ! $pid =~ ^[0-9]+$ ]]; then
    target_tty=""
    return 0
  fi
  target_pane=$pane target_tty=$tty target_shell=$pid
  front_of "$pid"
  # A tmux inside the pane: leave that to the key.
  [[ $target_front != tmux ]] || target_tty=""
}

# Kitty draws several windows from one process, but its remote control (on
# in Omarchy's kitty.conf) says which window has focus and its shell. The
# socket is in KITTY_LISTEN_ON, which kitty gives to every shell it starts.
kitty_focused() {
  local pid=$1 child socket="" shell tty comm=""
  { comm=$(< "/proc/$pid/comm"); } 2> /dev/null || true
  [[ $comm == kitty ]] && command -v kitten > /dev/null || return 1
  for child in $(children_of "$pid"); do
    socket=$(tr '\0' '\n' < "/proc/$child/environ" 2> /dev/null | sed -n 's/^KITTY_LISTEN_ON=//p' | head -n 1) || true
    [[ -z $socket ]] || break
  done
  [[ -n $socket ]] || return 1
  shell=$(timeout 2 kitten @ --to "$socket" ls 2> /dev/null | head -c 1048576 |
    jq -r 'first(.[] | select(.is_focused) | .tabs[] | select(.is_focused) | .windows[] | select(.is_focused) | .pid) // empty' 2> /dev/null) || return 1
  [[ $shell =~ ^[1-9][0-9]*$ ]] && tty=$(proc_tty "$shell") || return 1
  target_tty=$tty target_shell=$shell
}

# Colors the target found by find_target with <color> ("reset" for the
# project color of the shell's folder, or the theme's), and leaves it for the
# shell's next prompt.
paint_target() {
  local color=$1 shown inbox cwd
  shown=$color
  if [[ $color == reset ]]; then
    cwd=$(readlink "/proc/$target_shell/cwd" 2> /dev/null) || cwd=""
    _ct_load
    _ct_match_dir "$cwd"
    shown=${_ct_match,,}
  fi
  if [[ -n $target_pane ]]; then
    if [[ -n $shown ]]; then
      timeout 2 "${target_tmux[@]}" set -p -t "$target_pane" window-style "bg=$shown" \; \
        set -p -t "$target_pane" window-active-style "bg=$shown" > /dev/null 2>&1 || true
    else
      timeout 2 "${target_tmux[@]}" set -p -u -t "$target_pane" window-style \; \
        set -p -u -t "$target_pane" window-active-style > /dev/null 2>&1 || true
    fi
  elif [[ -n $shown ]]; then
    # shellcheck disable=SC2016 # $1 and $2 are for the inner bash
    # timeout: a terminal that stopped reading must not hang the key.
    timeout 1 bash -c 'printf "\e]11;%s\a" "$1" > "$2"' _ "$shown" "$target_tty" 2> /dev/null || true
  else
    # shellcheck disable=SC2016
    timeout 1 bash -c 'printf "\e]111\a" > "$1"' _ "$target_tty" 2> /dev/null || true
  fi
  inbox=$(inbox_for "$target_tty")
  [[ -d ${inbox%/*} ]] || mkdir -m 700 "${inbox%/*}"
  printf '%s\n' "$color" > "$inbox"
}

# ------------------------------------------------------------- panel queries

cmd_state() {
  read_config
  local fields=() problems=() paint=() i line
  for i in "${!project_lines[@]}"; do
    parse_project $((i + 1))
    fields+=("$_ct_path_text" "$_ct_path" "$_ct_color" "$([[ -d $_ct_path ]] && echo 1 || echo 0)")
  done
  _ct_load
  for i in "${!lines[@]}"; do
    line=${lines[i]}
    _ct_parse_line "$line"
    [[ $_ct_kind == problem ]] && problems+=("$((i + 1))" "${line:0:200}")
    # replace-group-keys was a setting when the keys were Super+Alt; an old
    # line is harmless, so it is not reported.
    if [[ $_ct_kind == setting && $_ct_key == paint-[1-9] ]] && ((${_ct_key#paint-} <= paint_keys)) &&
      valid_color "$_ct_value"; then
      paint+=("${_ct_key#paint-}" "${_ct_value,,}")
    elif [[ $_ct_kind == setting && $_ct_key != replace-group-keys ]]; then
      problems+=("$((i + 1))" "${line:0:200}")
    fi
  done
  local palette=() light=() status
  for i in "${!palette_colors[@]}"; do palette+=("${palette_names[i]}" "${palette_colors[i]}"); done
  for i in "${!light_colors[@]}"; do light+=("${light_names[i]}" "${light_colors[i]}"); done
  status=$(integration_json)
  jq -n -c \
    --arg file "$(display_path "$_ct_file")" \
    --argjson integration "$status" \
    --argjson projects "$(json_groups 4 "${fields[@]}")" \
    --argjson problems "$(json_groups 2 "${problems[@]}")" \
    --argjson palette "$(json_groups 2 "${palette[@]}")" \
    --argjson light "$(json_groups 2 "${light[@]}")" \
    --argjson paint "$(json_groups 2 "${paint[@]}")" \
    '{
      file: $file,
      integration: $integration,
      projects: [$projects | to_entries[] | {
        n: (.key + 1), path: .value[0], abs: .value[1], color: (.value[2] | ascii_downcase),
        name: (.value[1] | if . == "/" then "/" else split("/") | last end),
        exists: (.value[3] == "1")
      }],
      problems: [$problems[] | {line: (.[0] | tonumber), text: .[1]}],
      palette: [$palette[] | {name: .[0], color: .[1]}],
      paletteLight: [$light[] | {name: .[0], color: .[1]}],
      paint: ($paint | map({key: .[0], value: .[1]}) | from_entries)
    }'
}

# Prints the arguments as a JSON array of arrays, <size> items each.
json_groups() {
  local size=$1
  shift
  jq -n -c --argjson size "$size" '$ARGS.positional as $a | [range(0; $a | length; $size) as $i | $a[$i:$i + $size]]' --args "$@"
}

cmd_scan() {
  local current="" repos
  if command -v omarchy-cmd-terminal-cwd > /dev/null && [[ -n ${HYPRLAND_INSTANCE_SIGNATURE-} ]]; then
    current=$(timeout 2 omarchy-cmd-terminal-cwd 2> /dev/null | head -c 4096 | head -n 1) || current=""
  fi
  [[ $current == "$HOME" || ! -d $current ]] && current=""
  repos=$(find_repos)
  jq -n -c \
    --arg current "$([[ -n $current ]] && display_path "$current")" \
    --argjson repos "$repos" \
    --argjson conflicts "$(find_conflicts)" \
    '{currentDir: $current, repos: $repos, conflicts: $conflicts}'
}

# Git repositories in ~ and ~/Projects, most recently used first.
find_repos() {
  local list=() path found
  found=$(
    {
      timeout 3 find "$HOME" -mindepth 1 -maxdepth 2 \( -path "$HOME/.*" -prune \) -o -name .git -printf '%T@\t%h\n' 2> /dev/null || true
      for path in "$HOME/Projects" "$HOME/projects"; do
        [[ -d $path ]] || continue
        timeout 3 find "$path" -mindepth 1 -maxdepth 3 \( -name '.?*' ! -name .git -prune \) -o -name .git -printf '%T@\t%h\n' 2> /dev/null || true
      done
    } | sort -t $'\t' -k1,1nr | cut -f2- | awk '!seen[$0]++' | head -n 40
  ) || true
  while IFS= read -r path; do
    [[ -n $path && $path != *$'\t'* ]] || continue
    list+=("$(display_path "$path")")
  done <<< "$found"
  jq -n -c '$ARGS.positional' --args "${list[@]}"
}

# Other Super+Ctrl+Alt+digit and Super+Ctrl+Alt+Shift+digit keys ("shift"), so
# the panel can show them instead of silently fighting over them. Reads the text form of `hyprctl binds`: in the JSON form,
# keys bound by keycode ("SUPER + CTRL + ALT + code:10") have no key at all.
# Our own keys are recognized by their descriptions (see hypr/keys.lua).
find_conflicts() {
  if [[ -z ${HYPRLAND_INSTANCE_SIGNATURE-} ]] || ! command -v hyprctl > /dev/null; then
    echo '[]'
    return
  fi
  { timeout 3 hyprctl binds 2> /dev/null || true; } | head -c 4000000 | binds_to_conflicts
}

# Text of `hyprctl binds` on stdin -> JSON conflicts on stdout.
binds_to_conflicts() {
  awk '
    function flush() {
      if ((mods == "76" || mods == "77") && submap == "") {
        digit = ""; by_code = "false"
        if (key ~ /code:1[0-9]$/) { code = substr(key, length(key) - 1) + 0; digit = (code - 9) % 10; by_code = "true" }
        else if (key ~ /^[0-9]$/) digit = key
        if (digit != "" && desc !~ /^(Project [1-9]|Colorful Terminals|Terminal color)/) {
          gsub(/[\t\r]/, " ", desc)
          printf "%s\t%s\t%s\t%s\n", digit, by_code, substr(desc, 1, 80), (mods == "77" ? "true" : "false")
        }
      }
      mods = ""; submap = ""; key = ""; desc = ""
    }
    /^[^\t]/ { flush(); next }
    /^\tmodmask: / { mods = substr($0, 11) }
    /^\tsubmap: / { submap = substr($0, 10) }
    /^\tkey: / { key = substr($0, 7) }
    /^\tdescription: / { desc = substr($0, 15) }
    END { flush() }
  ' | jq -R -s -c '
    [split("\n")[] | select(length > 0) | split("\t")
     | {digit: (.[0] | tonumber), byCode: (.[1] == "true"),
        description: (if .[2] == "" then "(no description)" else .[2] end), shift: (.[3] == "true")}]
    | sort_by(.shift, .digit)'
}

cmd_dirs() {
  (($# == 1)) || die "usage: colorful-terminals dirs <path>"
  local query=$1 base prefix list=() entry
  case $query in
    "~") query="~/" ;;
  esac
  case $query in
    "~/"*) base=$HOME/${query:2} ;;
    /*) base=$query ;;
    *) echo '[]'; return ;;
  esac
  prefix=${base##*/}
  base=${base%/*}
  [[ -n $base ]] || base=/
  [[ -d $base ]] || { echo '[]'; return; }
  shopt -s nullglob
  [[ $prefix == .* ]] && shopt -s dotglob
  for entry in "${base%/}"/"$prefix"*/; do
    entry=${entry%/}
    [[ $entry == *[$'\n\t']* ]] && continue
    list+=("$(display_path "$entry")")
    ((${#list[@]} < 50)) || break
  done
  jq -n -c '$ARGS.positional' --args "${list[@]}"
}

# --------------------------------------------------------------- integration

# Every block the plugin knows. zsh and fish get one only when you use them.
all_targets=(bashrc zshrc fish hyprland menu)
fish_dir=${XDG_CONFIG_HOME:-$HOME/.config}/fish

# The blocks this system needs: bash, Hyprland and the menu always; zsh and
# fish when they are installed and in use (a config of their own, or the login
# shell). A config alone is not enough: installers such as uv create
# ~/.zshrc and ~/.config/fish on systems without those shells.
uses_shell() {
  local name=$1 config=$2
  command -v "$name" > /dev/null && [[ -e $config || ${SHELL##*/} == "$name" ]]
}
targets=(bashrc)
if uses_shell zsh "${ZDOTDIR:-$HOME}/.zshrc"; then targets+=(zshrc); fi
if uses_shell fish "$fish_dir"; then targets+=(fish); fi
targets+=(hyprland menu)

target_file() {
  case $1 in
    bashrc) printf '%s' "$HOME/.bashrc" ;;
    zshrc) printf '%s' "${ZDOTDIR:-$HOME}/.zshrc" ;;
    fish) printf '%s' "$fish_dir/conf.d/colorful-terminals.fish" ;;
    hyprland) printf '%s' "$HOME/.config/hypr/hyprland.lua" ;;
    menu) printf '%s' "$HOME/.config/omarchy/extensions/omarchy-menu.jsonc" ;;
  esac
}

# What each block is for, in the panel's words.
target_what() {
  case $1 in
    bashrc) printf 'bash: colors terminals as you cd' ;;
    zshrc) printf 'zsh: colors terminals as you cd' ;;
    fish) printf 'fish: colors terminals as you cd' ;;
    hyprland) printf 'Super+Ctrl+Alt keys for projects and colors' ;;
    menu) printf 'Omarchy menu: Style › Colorful Terminals' ;;
  esac
}

target_comment() {
  case $1 in
    bashrc | zshrc | fish) printf '#' ;;
    hyprland) printf -- '--' ;;
    menu) printf '  //' ;;
  esac
}

begin_marker() { printf '%s BEGIN colorful-terminals' "$(target_comment "$1")"; }
end_marker() { printf '%s END colorful-terminals' "$(target_comment "$1")"; }

# A path written relative to $HOME when possible, so synced dotfiles keep working.
bash_path() {
  if [[ $1 == "$HOME"/* ]]; then
    # shellcheck disable=SC2016 # $HOME is written literally into ~/.bashrc
    printf '"$HOME"/%q' "${1#"$HOME"/}"
  else
    printf '%q' "$1"
  fi
}

# A path for fish: "$HOME" and a single-quoted rest, since fish has no %q.
fish_path() {
  local rest=$1 prefix=""
  if [[ $rest == "$HOME"/* ]]; then
    # shellcheck disable=SC2016 # $HOME is written literally into the fish file
    prefix='"$HOME"'
    rest=/${rest#"$HOME"/}
  fi
  rest=${rest//\\/\\\\}
  printf "%s'%s'" "$prefix" "${rest//\'/\\\'}"
}

lua_string() {
  local s=${1//\\/\\\\}
  printf '"%s"' "${s//\"/\\\"}"
}

lua_path() {
  if [[ $1 == "$HOME"/* ]]; then
    printf 'os.getenv("HOME") .. %s' "$(lua_string "/${1#"$HOME"/}")"
  else
    lua_string "$1"
  fi
}

block_body() {
  local hook="$plugin_dir/shell/colorful-terminals"
  case $1 in
    bashrc)
      printf 'if [[ -r %s ]]; then source %s; fi\n' "$(bash_path "$hook.bash")" "$(bash_path "$hook.bash")"
      ;;
    zshrc)
      printf 'if [[ -r %s ]]; then source %s; fi\n' "$(bash_path "$hook.zsh")" "$(bash_path "$hook.zsh")"
      ;;
    fish)
      printf 'if test -r %s; source %s; end\n' "$(fish_path "$hook.fish")" "$(fish_path "$hook.fish")"
      ;;
    hyprland)
      printf 'do local dir = %s; local f = io.open(dir .. "/hypr/keys.lua"); if f then f:close(); dofile(dir .. "/hypr/keys.lua")(dir) end end\n' \
        "$(lua_path "$plugin_dir")"
      ;;
    menu)
      printf '  "style.colorful-terminals": {"icon":"󰏘","label":"Colorful Terminals","description":"Terminal color and hotkey for each project","action":"omarchy-shell shell toggle %s '"'"'{}'"'"'"},\n' "$PLUGIN_ID"
      ;;
  esac
}

block_text() {
  printf '%s (Colorful Terminals plugin; undo: colorful-terminals integration uninstall)\n' "$(begin_marker "$1")"
  block_body "$1"
  printf '%s\n' "$(end_marker "$1")"
}

has_block() {
  local file
  file=$(target_file "$1")
  [[ -f $file ]] && grep -qF -- "$(begin_marker "$1")" "$file"
}

# Installed means every block this system needs is there. "files" lists them
# for the panel.
integration_json() {
  local t args=() files=() all=true
  for t in "${all_targets[@]}"; do
    if has_block "$t"; then args+=(--argjson "$t" true); else args+=(--argjson "$t" false); fi
  done
  for t in "${targets[@]}"; do
    has_block "$t" || all=false
    files+=("$(display_path "$(target_file "$t")")" "$(target_what "$t")")
  done
  jq -n -c "${args[@]}" --argjson installed "$all" --argjson files "$(json_groups 2 "${files[@]}")" \
    '{bashrc: $bashrc, zshrc: $zshrc, fish: $fish, hyprland: $hyprland, menu: $menu,
      installed: $installed, files: [$files[] | {file: .[0], what: .[1]}]}'
}

where_text() {
  case $1 in
    bashrc | zshrc | hyprland) echo "at the end" ;;
    fish) echo "its own file" ;;
    menu) echo "at the top; shows up in the menu under Style" ;;
  esac
}

cmd_integration() {
  local action=${1-status} yes=0
  shift || true
  while (($#)); do
    case $1 in
      --yes | -y) yes=1 ;;
      *) die "unknown option '$1'" ;;
    esac
    shift
  done
  case $action in
    status) integration_status ;;
    preview) integration_preview ;;
    install)
      confirm "$yes" "Add these blocks?" integration_preview
      integration_install
      ;;
    uninstall) confirm "$yes" "Remove the Colorful Terminals blocks?" true && integration_uninstall ;;
    *) die "integration status|preview|install|uninstall" ;;
  esac
}

confirm() {
  local yes=$1 question=$2 show=$3 answer
  ((yes)) && return 0
  [[ -t 0 ]] || die "run this in a terminal, or add --yes to confirm"
  "$show"
  read -r -p "$question [y/N] " answer
  [[ $answer == [yY]* ]] || die "nothing changed"
}

integration_status() {
  local t
  for t in "${targets[@]}"; do
    if has_block "$t"; then
      printf 'installed      %s\n' "$(display_path "$(target_file "$t")")"
    else
      printf 'not installed  %s\n' "$(display_path "$(target_file "$t")")"
    fi
  done
}

integration_preview() {
  local t file
  for t in "${targets[@]}"; do
    file=$(target_file "$t")
    printf '%s  (%s%s)\n' "$(display_path "$file")" "$(where_text "$t")" "$([[ -f $file ]] || echo "; the file will be created")"
    block_text "$t" | sed 's/^/    /'
    echo
  done
  printf 'A backup of each file goes to %s first.\n' "$(display_path "$backup_dir")"
}

# The real file behind a path, so a symlinked ~/.bashrc (stow, chezmoi) stays a symlink.
real_file() { readlink -m -- "$1"; }

backup_file() {
  local name=$1 file=$2
  mkdir -p "$backup_dir"
  cp -p -- "$file" "$backup_dir/$name.$(date +%Y%m%d-%H%M%S)"
}

# Writes stdin to a file atomically, keeping its permissions.
replace_file() {
  local file=$1 tmp
  tmp=$(mktemp "${file%/*}/.colorful-terminals.XXXXXX")
  cat > "$tmp"
  if [[ -e $file ]]; then chmod --reference="$file" "$tmp"; else chmod 644 "$tmp"; fi
  mv -f "$tmp" "$file"
}

# Prints a file without the marked block.
strip_block() {
  local file=$1 begin=$2 end=$3 line inside=0
  while IFS= read -r line || [[ -n $line ]]; do
    if ((inside)); then
      [[ $line == "$end" ]] && inside=0
      continue
    fi
    if [[ $line == "$begin"* ]]; then
      inside=1
      continue
    fi
    printf '%s\n' "$line"
  done < "$file"
}

integration_install() {
  local t
  for t in "${targets[@]}"; do install_block "$t"; done
  echo "Installed. Open a new terminal to see project colors; Super+Ctrl+Alt+0 opens the settings."
}

install_block() {
  local t=$1 path file source
  path=$(target_file "$t")
  file=$(real_file "$path")
  mkdir -p "$backup_dir" "${file%/*}"
  source=$(mktemp "$backup_dir/.source.XXXXXX")

  if [[ -f $file ]]; then
    backup_file "$t" "$file"
    if has_block "$t"; then
      # Already there: refresh the block in place, e.g. after the plugin moved.
      strip_block "$file" "$(begin_marker "$t")" "$(end_marker "$t")" > "$source"
    else
      cp -p -- "$file" "$backup_dir/$t.original"
      rm -f -- "$backup_dir/$t.created"
      cat -- "$file" > "$source"
    fi
  else
    : > "$backup_dir/$t.created"
    rm -f -- "$backup_dir/$t.original"
    [[ $t != menu ]] || printf '{\n}\n' > "$source"
  fi
  write_with_block "$t" "$file" "$source"
  rm -f -- "$source"
  printf '  added block to %s\n' "$(display_path "$path")"
}

# Writes <source> plus the block to <file>: right after the opening "{" for
# the menu, at the end for the others.
write_with_block() {
  local t=$1 file=$2 source=$3 block line placed=0
  block=$(block_text "$t")
  if [[ $t == menu ]]; then
    grep -qE '^[[:space:]]*\{' "$source" ||
      die "could not find the opening { in $(display_path "$file"); nothing changed there"
    while IFS= read -r line || [[ -n $line ]]; do
      printf '%s\n' "$line"
      if ((!placed)) && [[ $line =~ ^[[:space:]]*\{ ]]; then
        printf '%s\n' "$block"
        placed=1
      fi
    done < "$source" | replace_file "$file"
  else
    {
      cat -- "$source"
      # Start on a fresh line if the file did not end with one.
      [[ ! -s $source || $(tail -c 1 -- "$source" | od -An -tx1) == *0a* ]] || echo
      printf '%s\n' "$block"
    } | replace_file "$file"
  fi
}

integration_uninstall() {
  local t path file stripped
  for t in "${all_targets[@]}"; do
    path=$(target_file "$t")
    if ! has_block "$t"; then
      # Quiet about shells this system does not use.
      [[ " ${targets[*]} " != *" $t "* ]] || printf '  nothing to remove in %s\n' "$(display_path "$path")"
      continue
    fi
    file=$(real_file "$path")
    backup_file "$t" "$file"
    stripped=$(mktemp "$backup_dir/.stripped.XXXXXX")
    strip_block "$file" "$(begin_marker "$t")" "$(end_marker "$t")" > "$stripped"

    if [[ -f $backup_dir/$t.created ]] && is_empty_skeleton "$t" "$stripped"; then
      rm -f -- "$file" "$stripped" "$backup_dir/$t.created"
      printf '  removed %s (the plugin had created it)\n' "$(display_path "$path")"
      continue
    fi
    # The original had no final newline: give back the exact original bytes.
    if [[ -f $backup_dir/$t.original ]] && cmp -s <(cat -- "$backup_dir/$t.original"; echo) "$stripped"; then
      cp -- "$backup_dir/$t.original" "$stripped"
    fi
    replace_file "$file" < "$stripped"
    rm -f -- "$stripped" "$backup_dir/$t.original" "$backup_dir/$t.created"
    printf '  removed block from %s\n' "$(display_path "$path")"
  done
  echo "Uninstalled. New terminals use the theme color; backups are in $(display_path "$backup_dir")."
}

is_empty_skeleton() {
  local content
  content=$(tr -d '[:space:]' < "$2")
  if [[ $1 == menu ]]; then [[ $content == "{}" ]]; else [[ -z $content ]]; fi
}

# ---------------------------------------------------------------------- main

main() {
  local command=${1-}
  shift || true
  case $command in
    list) cmd_list "$@" ;;
    add) cmd_add "$@" ;;
    remove) cmd_remove "$@" ;;
    move) cmd_move "$@" ;;
    color) cmd_color "$@" ;;
    open) cmd_open "$@" ;;
    paint) cmd_paint "$@" ;;
    paint-color) cmd_paint_color "$@" ;;
    offer) cmd_offer "$@" ;;
    state) cmd_state "$@" ;;
    scan) cmd_scan "$@" ;;
    dirs) cmd_dirs "$@" ;;
    integration) cmd_integration "$@" ;;
    "" | -h | --help | help) usage ;;
    *) die "unknown command '$command' (try --help)" ;;
  esac
}

main "$@"
