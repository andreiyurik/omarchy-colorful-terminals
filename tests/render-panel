#!/bin/bash
# Renders the settings panel offscreen with the real Omarchy shell theme and
# saves one PNG per state. Needs quickshell and an Omarchy shell tree.
#   tests/render-panel [output-dir]
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
shell_dir=${OMARCHY_PATH:-/usr/share/omarchy}/shell
if ! command -v quickshell > /dev/null || [[ ! -d $shell_dir/Commons ]]; then
  echo "SKIP: render-panel needs quickshell and the Omarchy shell"
  exit 0
fi
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
ln -s "$shell_dir/Commons" "$work/Commons"
ln -s "$shell_dir/Ui" "$work/Ui"
cp ProjectsView.qml ProjectRow.qml Notice.qml Model.js "$work/"
cp tests/render/shell.qml "$work/shell.qml"
out=${1:-$work/out}
mkdir -p "$out"
out=$(realpath "$out")
QT_QPA_PLATFORM=offscreen CT_RENDER_DIR="$out" timeout 30s quickshell --no-color -p "$work/shell.qml" > "$work/log" 2>&1 || true
grep -E 'PASS|FAIL|TypeError|ReferenceError|Unable to assign|Binding loop|Cannot|is not a|error' "$work/log" || true
if grep -qE 'FAIL|TypeError|ReferenceError|Unable to assign|Binding loop|Failed to load' "$work/log" || ! grep -q 'PASS: rendered hex' "$work/log"; then
  echo "render-panel: FAILED"
  exit 1
fi
echo "render-panel: ok ($out)"
