#!/bin/bash
# Runs the shell tests inside one test container (see tests/distros/run).
set -uo pipefail
cd /src || exit 1
. /etc/os-release
echo "$PRETTY_NAME: bash ${BASH_VERSION%%(*}, $(zsh --version | cut -d' ' -f2), fish $(fish --version | grep -o '[0-9.]*$'), $(tmux -V)"
status=0
for t in config integration hooks; do
  echo "== $t"
  bash "tests/$t.test.sh" || status=1
done
exit "$status"
