#!/bin/bash
# Runs the panel tests in the test container against the Omarchy shell tree
# at /omarchy, saving screenshots to /out (see tests/omarchy/run).
set -uo pipefail
cd /src || exit 1
mkdir -p "$XDG_RUNTIME_DIR" "$HOME" && chmod 700 "$XDG_RUNTIME_DIR"
echo "quickshell $(quickshell --version 2>/dev/null | head -n 1 | grep -o '[0-9][0-9.]*' | head -n 1), Omarchy shell at $(cat /omarchy/REF)"
status=0
echo "== panel"
OMARCHY_PATH=/omarchy tests/render-panel /out || status=1
echo "== panel-runtime"
OMARCHY_PATH=/omarchy tests/panel-runtime || status=1
exit "$status"
